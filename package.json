{
  "name": "site-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vue-tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
